# Copy to .env (local) or add each line as a GitHub Actions secret.
# 复制为 .env（本地运行），或逐行添加到 GitHub Actions Secrets。

ANTHROPIC_API_KEY=
# Only the platforms you use need a key. 只需填你用到的平台。
TWITTERAPI_IO_KEY=
YOUTUBE_API_KEY=
APIFY_TOKEN=
# EasyKOL: key from https://app.easykol.com/settings/quotaQuery and the email bound to it
EASYKOL_API_KEY=
EASYKOL_API_EMAIL=

# Email finding/verification (both optional). 找邮箱和验证（都可选）。
# Hunter: domain search when a creator has their own website. MillionVerifier: check before sending.
HUNTER_API_KEY=
MILLIONVERIFIER_API_KEY=

# Google service account JSON, either a file path or the raw JSON string.
# Google 服务账号 (service account) 密钥：文件路径或整段 JSON。
# Google login: EITHER a service account JSON (path or raw JSON)...
GOOGLE_SERVICE_ACCOUNT_JSON=
# ...OR your own Google account via OAuth (also used by the first Gmail mailbox)
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REFRESH_TOKEN below

# The Google Sheet ID (the long string in the sheet URL).
# 表格 ID（表格链接里那串长字符）。
SHEET_ID=

# OAuth client + refresh token (sheet access and Gmail sending; see README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Sending address and display name for the gmail mailbox in config.yaml
GMAIL_ADDRESS=
SENDER_NAME=
COMPANY_MAIL_PASSWORD=

# Slack bot (optional). SLACK_APP_TOKEN only for real-time Socket Mode.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_APP_TOKEN=
